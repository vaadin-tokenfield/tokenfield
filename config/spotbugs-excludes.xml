<?xml version="1.0" encoding="UTF-8"?>
<!--
    SpotBugs findings that are deliberately not enforced. Every entry is scoped
    to a single class/method/pattern so a genuine occurrence elsewhere still
    fails the check; see .github/workflows/code-quality.yml for how SpotBugs is
    run.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!--
        False positive: the Random is seeded once and then used 40 times, twice
        per iteration of the loop that follows it (a fixed seed, so the demo's
        example contacts are the same on every run — which the browser suite
        relies on). SpotBugs' detector misses uses inside the loop and reports
        the two calls as one-shot uses.
    -->
    <Match>
        <Class name="org.vaadin.tokenfield.DemoRoot"/>
        <Method name="generateTestContainer"/>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>

</FindBugsFilter>

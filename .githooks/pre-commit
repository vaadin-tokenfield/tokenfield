#!/usr/bin/env bash
# Blocks a commit that stages:
#  - org.jspecify into org/vaadin/tokenfield/client/**
#  - a disallowed org.junit.jupiter.api.Assertions member (anything but
#    assertThrows/fail) into any .java file
# Same rules as the Claude Code PreToolUse guards in .claude/settings.json.
#
# Not active until enabled once per checkout:
#   git config core.hooksPath .githooks
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
guards=(
    "$repo_root/scripts/check-jspecify-client-guard.sh"
    "$repo_root/scripts/check-junit-assertions-guard.sh"
)
status=0

while IFS= read -r -d '' path; do
    for guard in "${guards[@]}"; do
        if ! git show ":$path" | "$guard" "$path"; then
            status=1
        fi
    done
done < <(git diff --cached --name-only --diff-filter=ACM -z)

exit $status

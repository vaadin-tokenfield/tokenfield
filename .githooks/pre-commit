#!/usr/bin/env bash
# Blocks a commit that stages org.jspecify into org/vaadin/tokenfield/client/**.
# Same rule and message as the Claude Code PreToolUse guard in
# .claude/settings.json; both call scripts/check-jspecify-client-guard.sh.
#
# Not active until enabled once per checkout:
#   git config core.hooksPath .githooks
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
guard="$repo_root/scripts/check-jspecify-client-guard.sh"
status=0

while IFS= read -r -d '' path; do
    if ! git show ":$path" | "$guard" "$path"; then
        status=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM -z)

exit $status

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.vaadin.addons.tokenfield</groupId>
    <artifactId>tokenfield-parent</artifactId>
    <packaging>pom</packaging>
    <version>7.0.2-SNAPSHOT</version>
    <name>TokenField Add-on Parent Project</name>
    <description>
        TokenField Reloaded is an updated fork of the abandoned TokenField Vaadin add-on: a
        Vaadin 7 component for selecting multiple "tokens" via a ComboBox-style input, for use cases
        such as tagging and email address selection.
    </description>
    <url>https://github.com/vaadin-tokenfield/tokenfield</url>

    <modules>
        <module>tokenfield</module>
        <module>tokenfield-demo</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!--
            javac itself builds at 1.8 (needed by the JUnit 5/Cucumber/Playwright
            test harness). The org.vaadin.tokenfield.client package is the exception:
            Vaadin 7.7.x recompiles it with the bundled GWT 2.7 compiler, which caps
            source level at Java 7, so that package alone must avoid Java 8 syntax
            (lambdas, method references, etc.) regardless of this setting; see
            docs/code-quality.md.
        -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>

        <vaadin.version>7.7.17</vaadin.version>
        <vaadin.plugin.version>${vaadin.version}</vaadin.plugin.version>

        <!--
            Used only by the demo's issue #15 reproduction panel. JPAContainer
            3.2.0 is the last release of the add-on built against Vaadin 7 (4.0.0
            moved to Vaadin 8), and is published to the Vaadin Add-on Directory
            repository declared below, not to Maven Central.
            EclipseLink 2.7.x is the last javax.persistence line, and H2 2.2.x the
            last that runs on Java 8 - both match what this project builds against.
        -->
        <jpacontainer.version>3.2.0</jpacontainer.version>
        <eclipselink.version>2.7.16</eclipselink.version>
        <h2.version>2.2.224</h2.version>

        <junit.version>5.14.4</junit.version>
        <truth.version>1.4.5</truth.version>
        <playwright.version>1.62.0</playwright.version>
        <cucumber.version>7.34.6</cucumber.version>

        <maven.deploy.skip>true</maven.deploy.skip>

        <project.scm.id>github</project.scm.id>

        <!--
            Static analysis. Both plugins are pinned to their last releases that
            still run on Java 8, which is the JDK this project builds with; see
            .github/workflows/build.yml and the README's "Code quality"
            section for how they are run.
        -->
        <spotbugs.plugin.version>4.7.3.6</spotbugs.plugin.version>
        <pmd.plugin.version>3.21.2</pmd.plugin.version>

        <!--
            SonarQube analysis (Sonar's own scanner needs Java 17+, so it runs in
            its own workflow job, not in the Java 8 build). Skipped when no
            SONAR_TOKEN secret exists; the key/organization below must match the
            project created in SonarQube Cloud (or your own SonarQube server).
        -->
        <sonar.projectKey>vaadin-tokenfield_tokenfield</sonar.projectKey>
        <sonar.organization>vaadin-tokenfield</sonar.organization>
        <!-- GWT client-side code is compiled to JavaScript and exercised by the
             browser suite, not by unit tests; keep it out of the coverage figure
             Sonar reports, exactly as the JaCoCo check already does. -->
        <sonar.coverage.exclusions>**/client/**</sonar.coverage.exclusions>
        <!-- java:S110 measures inheritance depth. Vaadin 7's own component hierarchy
             (AbstractClientConnector -> AbstractComponent -> AbstractField -> CustomField,
             and the matching GWT widget chain) exhausts the rule's default limit of 5
             before any add-on code exists, so every class here trips it for reasons this
             project cannot change. Tuning the rule's max/filteredClasses parameters needs
             a custom quality profile, which the free SonarQube Cloud plan does not offer,
             so the rule is disabled here instead; see docs/code-quality.md. -->
        <!-- java:S1604 suggests replacing anonymous classes with lambdas. Sonar
             analyses at Java 8+, but org.vaadin.tokenfield.client is recompiled by
             the bundled GWT 2.7 compiler (Vaadin 7.7.x), which caps source level at
             Java 7 and rejects lambdas outright, so that package must keep its
             anonymous classes; see docs/code-quality.md. -->
        <sonar.issue.ignore.multicriteria>s110,s1604</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.s110.ruleKey>java:S110</sonar.issue.ignore.multicriteria.s110.ruleKey>
        <sonar.issue.ignore.multicriteria.s110.resourceKey>**/*.java</sonar.issue.ignore.multicriteria.s110.resourceKey>
        <sonar.issue.ignore.multicriteria.s1604.ruleKey>java:S1604</sonar.issue.ignore.multicriteria.s1604.ruleKey>
        <sonar.issue.ignore.multicriteria.s1604.resourceKey>**/client/**</sonar.issue.ignore.multicriteria.s1604.resourceKey>
    </properties>

    <organization>
        <name>Vaadin Community</name>
        <url>https://github.com/vaadin-tokenfield/</url>
    </organization>

    <developers>
        <developer>
            <name>Daniel Rothmaler</name>
            <email>drothmaler@googlemail.com</email>
            <roles>
                <role>Maintainer</role>
            </roles>
        </developer>
        <developer>
            <name>Marc Englund</name>
            <email>marc.englund@gmail.com</email>
            <roles>
                <role>Original Author</role>
            </roles>
        </developer>
    </developers>

    <!--
        Maven appends each child module's artifactId to inherited SCM/url paths by
        default; this is a single-repo, multi-module project, so the three
        child.scm.*.inherit.append.path attributes below suppress that (Maven 3.6.1+).
    -->
    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <url>https://github.com/vaadin-tokenfield/tokenfield/</url>
        <connection>scm:git:git@github.com:vaadin-tokenfield/tokenfield.git</connection>
        <developerConnection>scm:git:ssh://git@github.com:vaadin-tokenfield/tokenfield.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/vaadin-tokenfield/tokenfield/issues</url>
    </issueManagement>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <repositories>
        <repository>
            <id>vaadin-addons</id>
            <url>https://maven.vaadin.com/vaadin-addons</url>
        </repository>
    </repositories>

    <!--
        Releases publish to Maven Central via the "release" profile (see below);
        GitHub Packages requires an authenticated PAT to resolve and is unsuitable
        for the Directory's public Maven coordinate, so it is used for snapshots
        only.
    -->
    <distributionManagement>
        <repository>
            <id>vaadin-addons</id>
            <name>Vaadin Add-on Directory</name>
            <url>https://maven.vaadin.com/vaadin-addons</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/vaadin-tokenfield/tokenfield</url>
        </snapshotRepository>
    </distributionManagement>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                Note the artifactId: the jar file is named
                vaadin-jpacontainer-3.2.0.jar (the add-on POM sets that as its
                build finalName), but the artifact's coordinate is plain
                "jpacontainer".
            -->
            <dependency>
                <groupId>com.vaadin.addon</groupId>
                <artifactId>jpacontainer</artifactId>
                <version>${jpacontainer.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.persistence</groupId>
                <artifactId>org.eclipse.persistence.jpa</artifactId>
                <version>${eclipselink.version}</version>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.playwright</groupId>
                <artifactId>playwright</artifactId>
                <version>${playwright.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.truth</groupId>
                <artifactId>truth</artifactId>
                <version>${truth.version}</version>
            </dependency>
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-bom</artifactId>
                <version>${cucumber.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.vaadin</groupId>
                    <artifactId>vaadin-maven-plugin</artifactId>
                    <version>${vaadin.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>3.8.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.6.3</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.0-M1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.6.0-M1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>1.8.0</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.15</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.11.0</version>
                    <extensions>true</extensions>
                </plugin>

                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs.plugin.version}</version>
                    <configuration>
                        <!-- Deliberately not bound to a lifecycle phase: `mvn verify`
                             stays the fast build/test loop, and the build workflow
                             invokes spotbugs:check explicitly as an earlier step. -->
                        <effort>Max</effort>
                        <!-- Default "Medium" threshold: the add-on is clean at it today,
                             so it can fail the check. The remaining Low-priority
                             findings (serialVersionUID on inner listener classes and
                             friends) are inherited from the original add-on and are
                             reported by `-Dspotbugs.threshold=Low`, not enforced. -->
                        <threshold>Medium</threshold>
                        <xmlOutput>true</xmlOutput>
                        <excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs-excludes.xml</excludeFilterFile>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>${pmd.plugin.version}</version>
                    <configuration>
                        <targetJdk>${maven.compiler.target}</targetJdk>
                        <!-- Fail on PMD priority 1-2 (correctness-level) findings only.
                             The default ruleset's style advice (priority 3+) is
                             reported for review instead of enforced, so turning this
                             gate on doesn't require reformatting inherited code. -->
                        <failurePriority>2</failurePriority>
                        <printFailingErrors>true</printFailingErrors>
                        <!-- No maven-jxr-plugin report in this build to link to -->
                        <linkXRef>false</linkXRef>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-maven</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>3.6.3</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!--
                Signs and publishes release artifacts to Maven Central via the Central
                Portal. Requires a GPG signing key and a `central` server entry (Central
                Portal token) in settings.xml; see https://central.sonatype.org/publish/publish-portal-maven/
                Run with: mvn -Prelease -DskipTests deploy
            -->
            <id>release</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- Review the deployment in the Central Portal before releasing it -->
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <!-- Vaadin pre-release repositories -->
            <id>vaadin-prerelease</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>

            <repositories>
                <repository>
                    <id>vaadin-prereleases</id>
                    <url>https://maven.vaadin.com/vaadin-prereleases</url>
                </repository>
                <repository>
                    <id>vaadin-snapshots</id>
                    <url>https://oss.sonatype.org/content/repositories/vaadin-snapshots/</url>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>vaadin-prereleases</id>
                    <url>https://maven.vaadin.com/vaadin-prereleases</url>
                </pluginRepository>
                <pluginRepository>
                    <id>vaadin-snapshots</id>
                    <url>https://oss.sonatype.org/content/repositories/vaadin-snapshots/</url>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>
</project>
